# Argus Total — variabili d'ambiente del backend (COPIA in .env, NON committare).

# Database dedicato a Total (NIENTE condivisione con Argus Smart).
# Dev (default): SQLite locale.
DATABASE_URL=sqlite:///./argus_total.db
# Prod (Render Postgres): postgresql+psycopg://user:pass@host:5432/argus_total

# Provider satellitare: synthetic (nessun credito) | cdse (Copernicus reale).
PROVIDER_MODE=synthetic

# SECONDO account Copernicus (solo con PROVIDER_MODE=cdse). MAI nel codice.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# CORS: origini del frontend (CSV). In dev va bene "*".
CORS_ORIGINS=*
